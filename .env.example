# Root .env — populated by Neon CLI (`neon link` + `neon env pull`)
# Copy to apps/api/.env for the API: neon env pull --file apps/api/.env -s postgres -s object-storage
#
# Project: MintMusic (dark-king-03663821)
# Setup:   docs/DEPLOY.md

# ─── Neon Postgres ───
NEON_BRANCH=production
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require

# ─── Neon Object Storage (S3-compatible) ───
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=https://BRANCH_ID.storage.c-5.us-east-2.aws.neon.tech
AWS_REGION=us-east-2
