# MintMusic Web — copy to apps/web/.env.local
# (Same content as env.local.example; Next.js loads .env.local automatically)

# ─── Auth.js / NextAuth ───
AUTH_SECRET=
AUTH_URL=http://localhost:3000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

INTERNAL_API_SECRET=change-me-min-8-chars

NEXT_PUBLIC_API_URL=http://127.0.0.1:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_GOOGLE_PLAY_URL=

# Required in production for verified native-app links
APPLE_DEVELOPER_TEAM_ID=
ANDROID_APP_SHA256_CERT_FINGERPRINTS=

NEXT_PUBLIC_WC_PROJECT_ID=
NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_CONTRACT_ADDRESS=
