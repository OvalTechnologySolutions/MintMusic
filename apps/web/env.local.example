# MintMusic Web — copy to apps/web/.env.local
#
# Quick start:
#   cp apps/web/env.local.example apps/web/.env.local
#   # Fill AUTH_SECRET, OAuth credentials, and INTERNAL_API_SECRET (match apps/api/.env)
#
# Production (Vercel): see docs/DEPLOY.md or run `node scripts/sync-production-env.mjs`

# ─── Auth.js / NextAuth ───
# Generate: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Must match apps/api/.env INTERNAL_API_SECRET exactly
INTERNAL_API_SECRET=change-me-min-8-chars

# ─── Public URLs ───
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Web3 / WalletConnect (optional) ───
NEXT_PUBLIC_WC_PROJECT_ID=
NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_CONTRACT_ADDRESS=

# ─── Production OAuth redirect URIs (mintmusic.ai) ───
# Google: https://mintmusic.ai/api/auth/callback/google
# GitHub: https://mintmusic.ai/api/auth/callback/github
#
# Production env:
# AUTH_URL=https://mintmusic.ai
# NEXT_PUBLIC_APP_URL=https://mintmusic.ai
# NEXT_PUBLIC_API_URL=https://api.mintmusic.ai
