# Auth.js / NextAuth
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Must match apps/api INTERNAL_API_SECRET exactly
INTERNAL_API_SECRET=change-me-in-production

NEXT_PUBLIC_API_URL=http://127.0.0.1:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe (optional — checkout uses API secret key; no publishable key required for current flow)
# Webhook: stripe listen --forward-to localhost:4000/v1/stripe/webhook

NEXT_PUBLIC_WC_PROJECT_ID=
NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_CONTRACT_ADDRESS=
