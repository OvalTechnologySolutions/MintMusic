# Auth.js / NextAuth
AUTH_SECRET=generate-with-openssl-rand-base64-32
# Local: http://localhost:3000
# Production: https://mintmusic.ai
AUTH_URL=http://localhost:3000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Must match apps/api INTERNAL_API_SECRET exactly
INTERNAL_API_SECRET=change-me-in-production

# Local API: http://127.0.0.1:4000
# Production API: https://api.mintmusic.ai
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000
# Local: http://localhost:3000
# Production: https://mintmusic.ai
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe (optional — checkout uses API secret key; no publishable key required for current flow)
# Webhook: stripe listen --forward-to localhost:4000/v1/stripe/webhook
# Production webhook: https://api.mintmusic.ai/v1/stripe/webhook

NEXT_PUBLIC_WC_PROJECT_ID=
NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_CONTRACT_ADDRESS=

# ─── Production OAuth redirect URIs (mintmusic.ai) ───
# Google:  https://mintmusic.ai/api/auth/callback/google
# GitHub:  https://mintmusic.ai/api/auth/callback/github
