# Backend v2 — Environment variables

NODE_ENV=development
PORT=4000
# Local: http://localhost:3000
# Production: https://mintmusic.ai
CORS_ORIGIN=http://localhost:3000
API_VERSION=0.2.0
WEB_URL=http://localhost:3000
INTERNAL_API_SECRET=change-me-in-production

# ─── Required for v2 features ───
# Neon (recommended): run `neon link` then `neon env pull --file apps/api/.env`
# Uses pooled DATABASE_URL for queries; DATABASE_URL_UNPOOLED for migrations.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.neon.tech/DATABASE?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.neon.tech/DATABASE?sslmode=require

# Neon Object Storage (S3-compatible) — pulled by `neon env pull -s object-storage`
# Mapped automatically to S3_* in apps/api/src/config/env.ts
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=us-east-2
# Optional override (defaults to bucket name "uploads")
# S3_BUCKET=uploads

# Generate each secret: openssl rand -base64 32
INTERNAL_API_SECRET=change-me-in-production-min-8-chars
PLAYBACK_JWT_SECRET=
TASTE_TOKEN_ENCRYPTION_KEY=

# ─── Media uploads (S3, R2, MinIO, or Neon Object Storage) ───
# With Neon: `neon env pull -s object-storage` writes AWS_* vars; S3_* are mapped in env.ts
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
MEDIA_MAX_BYTES=524288000

# ─── Secure playback ───
PLAYBACK_JWT_SECRET=
PLAYBACK_TOKEN_TTL_SECONDS=900

# ─── Multi-DRM (Widevine + FairPlay) ───
DRM_PROVIDER=mock
DRM_LICENSE_SERVER_URL=
DRM_WIDEVINE_LA_URL=
DRM_FAIRPLAY_LA_URL=
DRM_FAIRPLAY_CERTIFICATE_URL=
DRM_CONTENT_ID_PREFIX=mintmusic

# ─── Background jobs (optional) ───
REDIS_URL=redis://localhost:6379

# ─── Stripe ───
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_RETURN_PATH=/settings?tab=payments

# ─── Taste profile OAuth ───
TASTE_TOKEN_ENCRYPTION_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SOUNDCLOUD_CLIENT_ID=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
APPLE_MUSIC_TEAM_ID=

# ─── Production (mintmusic.ai) ───
# CORS_ORIGIN=https://mintmusic.ai
# WEB_URL=https://mintmusic.ai
# STRIPE webhook: https://api.mintmusic.ai/v1/stripe/webhook
