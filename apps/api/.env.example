# MintMusic API — copy to apps/api/.env
#
# Quick start (Neon):
#   neon link --project-id dark-king-03663821 --org-id org-dry-grass-17126034
#   neon env pull --file apps/api/.env -s postgres -s object-storage
#   npm run db:push -w @mintmusic/api && npm run db:seed -w @mintmusic/api
#
# Generate secrets: openssl rand -base64 32

# ─── Server ───
NODE_ENV=development
PORT=4000
API_VERSION=0.2.0
CORS_ORIGIN=http://localhost:3000
WEB_URL=http://localhost:3000

# Shared with web app — must match exactly
INTERNAL_API_SECRET=change-me-min-8-chars

# ─── Database (Neon Postgres) ───
# Pooled URL for runtime queries; unpooled for Prisma migrations (db:push / migrate)
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.neon.tech/DATABASE?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.neon.tech/DATABASE?sslmode=require
NEON_BRANCH=production

# ─── Object storage (Neon or S3/R2/MinIO) ───
# Neon: `neon env pull -s object-storage` writes AWS_*; mapped to S3_* automatically in env.ts
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=us-east-2
# Optional S3 overrides (defaults: bucket=uploads, region/keys from AWS_*)
# S3_BUCKET=uploads
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
MEDIA_MAX_BYTES=524288000

# ─── Secure playback ───
PLAYBACK_JWT_SECRET=
PLAYBACK_TOKEN_TTL_SECONDS=900

# ─── DRM (optional) ───
DRM_PROVIDER=mock
DRM_LICENSE_SERVER_URL=
DRM_WIDEVINE_LA_URL=
DRM_FAIRPLAY_LA_URL=
DRM_FAIRPLAY_CERTIFICATE_URL=
DRM_CONTENT_ID_PREFIX=mintmusic

# ─── Background jobs (optional) ───
REDIS_URL=redis://localhost:6379

# ─── Stripe (optional) ───
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_RETURN_PATH=/settings?tab=payments

# ─── Taste profile OAuth (optional) ───
TASTE_TOKEN_ENCRYPTION_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SOUNDCLOUD_CLIENT_ID=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
APPLE_MUSIC_TEAM_ID=

# ─── CrateBuilder ───
# Comma-separated admin emails (or set User.role=admin)
CRATEBUILDER_ADMIN_EMAILS=
# Cron for daily ingest+export. Default 0 17 * * * = 17:00 UTC (fixed EST UTC-05 year-round).
CRATEBUILDER_CRON=0 17 * * *
# fixed_est = interpret cron in UTC (recommended). iana = use CRATEBUILDER_IANA_TZ (follows DST).
CRATEBUILDER_TZ_MODE=fixed_est
CRATEBUILDER_IANA_TZ=America/New_York
CRATEBUILDER_MAX_HOPS=2
CRATEBUILDER_PER_ARTIST_URL_LIMIT=8
CRATEBUILDER_COMMENT_LIMIT=50
CRATEBUILDER_TOTAL_URL_BUDGET=200
CRATEBUILDER_DOMAIN_DELAY_MS=1000
# MusicBrainz WS: free for non-commercial; enable only with MetaBrainz commercial agreement
MUSICBRAINZ_ENABLED=false
MUSICBRAINZ_USER_AGENT=MintMusic-CrateBuilder/0.1 (https://mintmusic.ai; cratebuilder@mintmusic.ai)
WIKIDATA_ENABLED=true
# Optional LLM-assisted structured extraction (never invents facts)
OPENAI_API_KEY=

# ─── Production (mintmusic.ai) ───
# CORS_ORIGIN=https://mintmusic.ai
# WEB_URL=https://mintmusic.ai
# Stripe webhook: https://api.mintmusic.ai/v1/stripe/webhook
