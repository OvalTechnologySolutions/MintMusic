# MintMusic API — copy to apps/api/.env
#
# Quick start (Neon):
#   neon link --project-id dark-king-03663821 --org-id org-dry-grass-17126034
#   neon env pull --file apps/api/.env -s postgres -s object-storage
#   npm run db:push -w @mintmusic/api && npm run db:seed -w @mintmusic/api
#
# Generate secrets: openssl rand -base64 32

# ─── Server ───
NODE_ENV=development
PORT=4000
API_VERSION=0.2.0
CORS_ORIGIN=http://localhost:3000
WEB_URL=http://localhost:3000

# Shared with web app — must match exactly
INTERNAL_API_SECRET=change-me-min-8-chars

# ─── Database (Neon Postgres) ───
# Pooled URL for runtime queries; unpooled for Prisma migrations (db:push / migrate)
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.neon.tech/DATABASE?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.neon.tech/DATABASE?sslmode=require
NEON_BRANCH=production

# ─── Object storage (Neon or S3/R2/MinIO) ───
# Neon: `neon env pull -s object-storage` writes AWS_*; mapped to S3_* automatically in env.ts
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=us-east-2
# Optional S3 overrides (defaults: bucket=uploads, region/keys from AWS_*)
# S3_BUCKET=uploads
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
MEDIA_MAX_BYTES=524288000

# ─── Secure playback ───
PLAYBACK_JWT_SECRET=
PLAYBACK_TOKEN_TTL_SECONDS=900

# ─── DRM (optional) ───
DRM_PROVIDER=mock
DRM_LICENSE_SERVER_URL=
DRM_WIDEVINE_LA_URL=
DRM_FAIRPLAY_LA_URL=
DRM_FAIRPLAY_CERTIFICATE_URL=
DRM_CONTENT_ID_PREFIX=mintmusic

# ─── Background jobs (optional) ───
REDIS_URL=redis://localhost:6379

# ─── Stripe (optional) ───
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_RETURN_PATH=/settings?tab=payments

# ─── Taste profile OAuth (optional) ───
TASTE_TOKEN_ENCRYPTION_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SOUNDCLOUD_CLIENT_ID=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
APPLE_MUSIC_TEAM_ID=

# ─── Production (mintmusic.ai) ───
# CORS_ORIGIN=https://mintmusic.ai
# WEB_URL=https://mintmusic.ai
# Stripe webhook: https://api.mintmusic.ai/v1/stripe/webhook
