// MintMusic Backend v2 — PostgreSQL schema
// Run: npx prisma migrate dev

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum UserRole {
  collector
  creator
  admin
}

enum CreatorStatus {
  none
  pending
  approved
  rejected
}

enum ReleaseType {
  single
  album
  music_video
  visualizer
}

enum MediaFormat {
  mp3
  wav
  mp4
}

enum MediaProcessingStatus {
  pending
  processing
  ready
  failed
}

enum PostType {
  announcement
  release
  behind_the_scenes
  listening_party
}

enum DiscoveryChannelType {
  genre
  mood
  regional
  editorial
}

enum TastePlatform {
  spotify
  apple_music
  soundcloud
  tiktok
}

enum RadioOptInStatus {
  pending
  active
  paused
  rejected
}

enum DrmPackagingStatus {
  none
  queued
  packaging
  ready
  failed
}

enum BroadcastLicenseType {
  mechanical
  performance
  sync
  blanket
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  image     String?
  role      UserRole @default(collector)
  creatorStatus CreatorStatus @default(none) @map("creator_status")
  walletAddress String? @map("wallet_address")
  stripeConnectAccountId String? @map("stripe_connect_account_id")
  stripeConnectChargesEnabled Boolean @default(false) @map("stripe_charges_enabled")
  stripeConnectPayoutsEnabled Boolean @default(false) @map("stripe_payouts_enabled")
  provider  String
  providerAccountId String @map("provider_account_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  socialLinks       SocialLink[]
  creatorProfile    CreatorProfile?
  mediaAssets       MediaAsset[]
  releases          Release[]
  posts             Post[]
  followers         Follow[]       @relation("CreatorFollows")
  following         Follow[]       @relation("CollectorFollows")
  purchases         Purchase[]
  playEvents        PlayEvent[]
  radioOptIns       RadioOptIn[]
  tasteConnections  TasteConnection[]
  tasteProfile      TasteProfile?
  playbackSessions  PlaybackSession[]
  accountDeletionRequest AccountDeletionRequest?

  @@map("users")
}

model AccountDeletionRequest {
  id          String   @id @default(cuid())
  userId      String   @unique @map("user_id")
  status      String   @default("pending")
  requestedAt DateTime @default(now()) @map("requested_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account_deletion_requests")
}

model SocialLink {
  id               String   @id @default(cuid())
  userId           String   @map("user_id")
  platform         String
  url              String
  label            String?
  isPrimary        Boolean  @default(false) @map("is_primary")
  connectionType   String   @default("manual") @map("connection_type")
  externalAccountId String? @map("external_account_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform])
  @@map("social_links")
}

model CreatorProfile {
  id          String   @id @default(cuid())
  userId      String   @unique @map("user_id")
  displayName String   @map("display_name")
  bio         String?
  genreTags   String[] @default([]) @map("genre_tags")
  regionCode  String?  @map("region_code")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("creator_profiles")
}

model MediaAsset {
  id              String                @id @default(cuid())
  creatorId       String                @map("creator_id")
  filename        String
  mimeType        String                @map("mime_type")
  format          MediaFormat
  byteSize        BigInt                @map("byte_size")
  durationMs      Int?                  @map("duration_ms")
  storageKey      String                @map("storage_key")
  streamKey       String?               @map("stream_key")
  processingStatus MediaProcessingStatus @default(pending) @map("processing_status")
  checksumSha256  String?               @map("checksum_sha256")
  drmStatus       DrmPackagingStatus    @default(none) @map("drm_status")
  contentKeyId    String?               @map("content_key_id")
  hlsManifestKey  String?               @map("hls_manifest_key")
  dashManifestKey String?               @map("dash_manifest_key")
  widevineReady   Boolean               @default(false) @map("widevine_ready")
  fairplayReady   Boolean               @default(false) @map("fairplay_ready")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")

  creator User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  releases Release[]
  tracks   Track[]
  drmJobs  DrmPackagingJob[]

  @@index([creatorId])
  @@map("media_assets")
}

model Release {
  id          String      @id @default(cuid())
  creatorId   String      @map("creator_id")
  mediaAssetId String?    @map("media_asset_id")
  type        ReleaseType
  title       String
  description String?
  coverUrl    String?     @map("cover_url")
  genreTags   String[]    @default([]) @map("genre_tags")
  priceCents  Int         @map("price_cents")
  currency    String      @default("usd")
  published   Boolean     @default(false)
  publishedAt DateTime?   @map("published_at")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  creator    User        @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset? @relation(fields: [mediaAssetId], references: [id])
  tracks     Track[]
  purchases  Purchase[]
  posts      Post[]
  playEvents PlayEvent[]

  @@index([creatorId, published])
  @@index([type])
  @@map("releases")
}

model Track {
  id           String @id @default(cuid())
  releaseId    String @map("release_id")
  title        String
  trackNumber  Int    @map("track_number")
  durationMs   Int?   @map("duration_ms")
  mediaAssetId String @map("media_asset_id")

  release    Release    @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id])

  @@unique([releaseId, trackNumber])
  @@map("tracks")
}

model Post {
  id        String   @id @default(cuid())
  creatorId String   @map("creator_id")
  type      PostType @default(announcement)
  body      String
  releaseId String?  @map("release_id")
  mediaUrl  String?  @map("media_url")
  publishedAt DateTime @default(now()) @map("published_at")
  createdAt DateTime @default(now()) @map("created_at")

  creator User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  release Release? @relation(fields: [releaseId], references: [id], onDelete: SetNull)

  @@index([creatorId, publishedAt(sort: Desc)])
  @@map("posts")
}

model Follow {
  id          String   @id @default(cuid())
  collectorId String   @map("collector_id")
  creatorId   String   @map("creator_id")
  createdAt   DateTime @default(now()) @map("created_at")

  collector User @relation("CollectorFollows", fields: [collectorId], references: [id], onDelete: Cascade)
  creator   User @relation("CreatorFollows", fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([collectorId, creatorId])
  @@index([collectorId])
  @@map("follows")
}

model Purchase {
  id              String   @id @default(cuid())
  collectorId     String   @map("collector_id")
  releaseId       String   @map("release_id")
  stripePaymentId String?  @map("stripe_payment_id")
  amountCents     Int      @map("amount_cents")
  purchasedAt     DateTime @default(now()) @map("purchased_at")

  collector User    @relation(fields: [collectorId], references: [id], onDelete: Cascade)
  release   Release @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  @@unique([collectorId, releaseId])
  @@index([collectorId])
  @@map("purchases")
}

model PlayEvent {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  releaseId   String   @map("release_id")
  source      String   // collection | discovery | radio | feed
  deviceType  String?  @map("device_type")
  regionCode  String?  @map("region_code")
  listenedMs  Int      @default(0) @map("listened_ms")
  createdAt   DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  release Release @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  @@index([releaseId, createdAt])
  @@index([userId, createdAt])
  @@map("play_events")
}

model DiscoveryChannel {
  id          String               @id @default(cuid())
  slug        String               @unique
  name        String
  description String?
  type        DiscoveryChannelType
  genreTags   String[]             @default([]) @map("genre_tags")
  regionCode  String?              @map("region_code")
  active      Boolean              @default(true)
  createdAt   DateTime             @default(now()) @map("created_at")

  radioRotations RadioRotation[]

  @@map("discovery_channels")
}

model RadioOptIn {
  id          String           @id @default(cuid())
  creatorId   String           @map("creator_id")
  releaseId   String           @map("release_id")
  regionCode  String           @map("region_code")
  status      RadioOptInStatus @default(active)
  licensedAt  DateTime?        @map("licensed_at")
  optedInAt   DateTime         @default(now()) @map("opted_in_at")

  creator User @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([releaseId, regionCode])
  @@index([regionCode, status])
  @@map("radio_opt_ins")
}

model RadioRotation {
  id        String   @id @default(cuid())
  channelId String   @map("channel_id")
  releaseId String   @map("release_id")
  weight    Int      @default(1)
  startsAt  DateTime @map("starts_at")
  endsAt    DateTime? @map("ends_at")

  channel DiscoveryChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId, startsAt])
  @@map("radio_rotations")
}

model TasteConnection {
  id              String        @id @default(cuid())
  userId          String        @map("user_id")
  platform        TastePlatform
  accessTokenEnc  String        @map("access_token_enc")
  refreshTokenEnc String?       @map("refresh_token_enc")
  expiresAt       DateTime?     @map("expires_at")
  scopes          String[]      @default([])
  connectedAt     DateTime      @default(now()) @map("connected_at")
  lastSyncedAt    DateTime?     @map("last_synced_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform])
  @@map("taste_connections")
}

model TasteProfile {
  id           String   @id @default(cuid())
  userId       String   @unique @map("user_id")
  topGenres    Json     @default("[]") @map("top_genres")
  topArtists   Json     @default("[]") @map("top_artists")
  topTracks    Json     @default("[]") @map("top_tracks")
  sourceSummary Json    @default("{}") @map("source_summary")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("taste_profiles")
}

model PlaybackSession {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  releaseId  String   @map("release_id")
  trackId    String?  @map("track_id")
  drmSystem  String?  @map("drm_system")
  tokenHash  String   @map("token_hash")
  expiresAt  DateTime @map("expires_at")
  deviceHint String?  @map("device_hint")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId, releaseId])
  @@map("playback_sessions")
}

model BroadcastLicense {
  id           String               @id @default(cuid())
  regionCode   String               @map("region_code")
  name         String
  licenseType  BroadcastLicenseType @map("license_type")
  rightsHolder String               @map("rights_holder")
  territories  String[]             @default([])
  validFrom    DateTime             @map("valid_from")
  validTo      DateTime?            @map("valid_to")
  documentUrl  String?              @map("document_url")
  active       Boolean              @default(true)
  createdAt    DateTime             @default(now()) @map("created_at")

  @@index([regionCode, active])
  @@map("broadcast_licenses")
}

model DrmPackagingJob {
  id           String             @id @default(cuid())
  mediaAssetId String             @map("media_asset_id")
  status       DrmPackagingStatus @default(queued)
  provider     String             @default("aws_mediaconvert")
  errorMessage String?            @map("error_message")
  queuedAt     DateTime           @default(now()) @map("queued_at")
  completedAt  DateTime?          @map("completed_at")

  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@index([mediaAssetId, status])
  @@map("drm_packaging_jobs")
}

// ─── CrateBuilder (artist discovery / outreach foundation) ───

enum CbSourceType {
  editorial_url
  social_account
  playlist
  manual
  feed
}

enum CbEntityType {
  solo
  group
  unknown
}

enum CbOutreachStatus {
  not_reviewed
  ready
  contacted
  responded
  onboarded
  do_not_contact
}

enum CbContactKind {
  booking
  management
  inquiries
  phone
  form
  other
}

enum CbReviewStatus {
  pending
  accepted
  rejected
  needs_review
}

enum CbRunStatus {
  queued
  running
  completed
  completed_partial
  failed
  cancelled
}

enum CbRelationshipType {
  group_member
  collaborator
  manager
  booking_agent
  publicist
  label
  other
}

model CbConnectorStatus {
  id         String   @id
  enabled    Boolean  @default(false)
  reason     String?
  lastError  String?  @map("last_error")
  lastOkAt   DateTime? @map("last_ok_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("cb_connector_statuses")
}

model CbSource {
  id               String       @id @default(cuid())
  name             String
  type             CbSourceType
  url              String?
  connectorId      String       @map("connector_id")
  enabled          Boolean      @default(true)
  configJson       Json         @default("{}") @map("config_json")
  publicationDate  DateTime?    @map("publication_date")
  lastFetchedAt    DateTime?    @map("last_fetched_at")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  items CbSourceItem[]

  @@index([enabled, connectorId])
  @@map("cb_sources")
}

model CbSourceItem {
  id          String    @id @default(cuid())
  sourceId    String    @map("source_id")
  runId       String?   @map("run_id")
  externalKey String?   @map("external_key")
  title       String?
  url         String?
  publishedAt DateTime? @map("published_at")
  payloadHash String?   @map("payload_hash")
  rawExcerpt  String?   @map("raw_excerpt") @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")

  source CbSource        @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  run    CbIngestionRun? @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@unique([sourceId, externalKey])
  @@index([runId])
  @@map("cb_source_items")
}

model CbArtist {
  id                 String           @id @default(cuid())
  stageName          String           @map("stage_name")
  entityType         CbEntityType     @default(unknown) @map("entity_type")
  bio                String?          @db.Text
  genres             String[]         @default([])
  hometownCity       String?          @map("hometown_city")
  hometownRegion     String?          @map("hometown_region")
  hometownCountry    String?          @map("hometown_country")
  currentCity        String?          @map("current_city")
  currentRegion      String?          @map("current_region")
  currentCountry     String?          @map("current_country")
  website            String?
  linkInBioUrl       String?          @map("link_in_bio_url")
  firstDiscoveredAt  DateTime         @default(now()) @map("first_discovered_at")
  discoveryVisible   Boolean          @default(false) @map("discovery_visible")
  emergingStatus     String?          @map("emerging_status")
  outreachStatus     CbOutreachStatus @default(not_reviewed) @map("outreach_status")
  outreachNotes      String?          @map("outreach_notes") @db.Text
  outreachAssignedTo String?          @map("outreach_assigned_to")
  preferredContactId String?          @unique @map("preferred_contact_id")
  linkedUserId       String?          @map("linked_user_id")
  adminLockedFields  String[]         @default([]) @map("admin_locked_fields")
  suppressedAt       DateTime?        @map("suppressed_at")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  preferredContact CbContact?      @relation("PreferredContact", fields: [preferredContactId], references: [id], onDelete: SetNull)
  aliases          CbAlias[]
  externalIds      CbExternalId[]
  profiles         CbProfile[]
  contacts         CbContact[]     @relation("ArtistContacts")
  observations     CbObservation[]
  relationshipsFrom CbRelationship[] @relation("RelFrom")
  relationshipsTo   CbRelationship[] @relation("RelTo")
  reviewItems      CbReviewQueueItem[]

  @@index([stageName])
  @@index([firstDiscoveredAt])
  @@index([outreachStatus])
  @@index([discoveryVisible])
  @@map("cb_artists")
}

model CbAlias {
  id        String   @id @default(cuid())
  artistId  String   @map("artist_id")
  alias     String
  createdAt DateTime @default(now()) @map("created_at")

  artist CbArtist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@unique([artistId, alias])
  @@index([alias])
  @@map("cb_aliases")
}

model CbExternalId {
  id         String   @id @default(cuid())
  artistId   String   @map("artist_id")
  provider   String
  externalId String   @map("external_id")
  url        String?
  createdAt  DateTime @default(now()) @map("created_at")

  artist CbArtist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId])
  @@index([artistId])
  @@map("cb_external_ids")
}

model CbProfile {
  id                String   @id @default(cuid())
  artistId          String   @map("artist_id")
  platform          String
  url               String
  handle            String?
  externalAccountId String?  @map("external_account_id")
  verified          Boolean  @default(false)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  artist CbArtist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@unique([artistId, platform, url])
  @@index([platform, handle])
  @@map("cb_profiles")
}

model CbContact {
  id                 String        @id @default(cuid())
  artistId           String        @map("artist_id")
  kind               CbContactKind
  value              String
  role               String?
  representativeName String?       @map("representative_name")
  organization       String?
  verified           Boolean       @default(false)
  preferred          Boolean       @default(false)
  suppressed         Boolean       @default(false)
  suppressedAt       DateTime?     @map("suppressed_at")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  artist              CbArtist  @relation("ArtistContacts", fields: [artistId], references: [id], onDelete: Cascade)
  preferredForArtist  CbArtist? @relation("PreferredContact")

  @@index([artistId, kind])
  @@index([value])
  @@map("cb_contacts")
}

model CbRelationship {
  id             String              @id @default(cuid())
  fromArtistId   String              @map("from_artist_id")
  toArtistId     String              @map("to_artist_id")
  type           CbRelationshipType
  label          String?
  evidenceId     String?             @map("evidence_id")
  createdAt      DateTime            @default(now()) @map("created_at")

  fromArtist CbArtist @relation("RelFrom", fields: [fromArtistId], references: [id], onDelete: Cascade)
  toArtist   CbArtist @relation("RelTo", fields: [toArtistId], references: [id], onDelete: Cascade)

  @@unique([fromArtistId, toArtistId, type])
  @@map("cb_relationships")
}

model CbObservation {
  id           String         @id @default(cuid())
  artistId     String?        @map("artist_id")
  field        String
  value        String         @db.Text
  sourceUrl    String?        @map("source_url")
  sourceType   String?        @map("source_type")
  retrievedAt  DateTime       @default(now()) @map("retrieved_at")
  excerpt      String?        @db.Text
  method       String
  confidence   Float          @default(0.5)
  explanation  String?        @db.Text
  reviewStatus CbReviewStatus @default(pending) @map("review_status")
  runId        String?        @map("run_id")
  createdAt    DateTime       @default(now()) @map("created_at")

  artist CbArtist?       @relation(fields: [artistId], references: [id], onDelete: Cascade)
  run    CbIngestionRun? @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([artistId, field])
  @@index([reviewStatus])
  @@map("cb_observations")
}

model CbReviewQueueItem {
  id          String         @id @default(cuid())
  artistId    String?        @map("artist_id")
  kind        String
  title       String
  detail      String?        @db.Text
  payloadJson Json           @default("{}") @map("payload_json")
  status      CbReviewStatus @default(needs_review)
  createdAt   DateTime       @default(now()) @map("created_at")
  resolvedAt  DateTime?      @map("resolved_at")

  artist CbArtist? @relation(fields: [artistId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@map("cb_review_queue_items")
}

model CbIngestionRun {
  id              String      @id @default(cuid())
  status          CbRunStatus @default(queued)
  trigger         String      @default("manual")
  lockToken       String?     @unique @map("lock_token")
  scheduledFor    DateTime?   @map("scheduled_for")
  startedAt       DateTime?   @map("started_at")
  completedAt     DateTime?   @map("completed_at")
  checkpointJson  Json        @default("{}") @map("checkpoint_json")
  coverageNotes   String?     @map("coverage_notes") @db.Text
  summaryJson     Json        @default("{}") @map("summary_json")
  errorMessage    String?     @map("error_message") @db.Text
  partialFailure  Boolean     @default(false) @map("partial_failure")
  createdAt       DateTime    @default(now()) @map("created_at")

  sourceItems  CbSourceItem[]
  observations CbObservation[]
  visitedUrls  CbVisitedUrl[]
  exports      CbExport[]

  @@index([status, createdAt])
  @@map("cb_ingestion_runs")
}

model CbVisitedUrl {
  id        String   @id @default(cuid())
  runId     String   @map("run_id")
  url       String
  hopDepth  Int      @default(0) @map("hop_depth")
  status    String
  createdAt DateTime @default(now()) @map("created_at")

  run CbIngestionRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, url])
  @@map("cb_visited_urls")
}

model CbExport {
  id           String   @id @default(cuid())
  runId        String?  @map("run_id")
  filename     String
  storageKey   String   @map("storage_key")
  exportDate   DateTime @map("export_date") @db.Date
  complete     Boolean  @default(true)
  isLatest     Boolean  @default(false) @map("is_latest")
  byteSize     Int?     @map("byte_size")
  createdAt    DateTime @default(now()) @map("created_at")

  run CbIngestionRun? @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([exportDate])
  @@index([isLatest])
  @@map("cb_exports")
}
